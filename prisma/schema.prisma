generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id                 String   @id @default(uuid())
  externalId         String?  @unique
  title              String
  description        String?
  price              Float
  originalPrice      Float?
  discountPercentage Float?
  merchant           String
  source             String
  url                String
  imageUrl           String?
  category           String
  temperature        Int?
  isExpired          Boolean  @default(false)
  discordAlertSent   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([merchant])
  @@index([createdAt])
}
